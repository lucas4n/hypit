{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": { "env": { "use": "@hypit/credential-store-env" } },
  "endpoints": {
    "magnific": {
      "use": "@machinement/provider-magnific",
      "config": {
        "credentialsFile": "/home/t-gamer/Machinement/engines/socialmedia/credentials/magnific-mcp.json",
        "folderReference": "<magnific.project_ref do workspace>"
      }
    },
    "fal": { "use": "@machinement/provider-fal", "config": { "apiKey": { "store": "env", "key": "FAL_KEY" } } },
    "media.local": { "use": "@hypit/provider-media-local", "config": { "defaultConcurrency": 2 } },
    "hyperframes.local": { "use": "@hypit/provider-hyperframes-local", "config": { "workers": 2, "defaultConcurrency": 1 } }
  },
  "bindings": {
    "@hypit/gpt-image@1#gpt-image-2": "magnific",
    "@hypit/nano-banana@1#nano-banana-2": "magnific",
    "@hypit/nano-banana@1#nano-banana-pro": "magnific",
    "@hypit/seedance@1#seedance-2": "magnific",
    "@hypit/seedance@1#seedance-2-fast": "magnific",
    "@hypit/seedance@1#seedance-2-mini": "magnific"
  }
}
